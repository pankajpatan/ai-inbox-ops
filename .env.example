# With a key, Claude classifies emails and drafts replies; without one, keyword rules and templates do.
ANTHROPIC_API_KEY=
INBOX_MODEL=claude-opus-5-5
INBOX_EFFORT=low

# Alerts for urgent emails, complaints, overdue replies and failures. Slack incoming webhook, https only.
# Without it, alerts go to the log.
ALERT_WEBHOOK_URL=
PUBLIC_URL=http://127.0.0.1:8030

DATABASE_PATH=inbox.db
RULES_PATH=routing.yaml
