# With a key, Claude classifies emails and drafts replies; without one, keyword rules and templates do.
ANTHROPIC_API_KEY=
INBOX_MODEL=claude-opus-5-5
INBOX_EFFORT=low

# Dashboard: keep DEMO_MODE=true on localhost only. With DEMO_MODE=false the dashboard needs ADMIN_PASSWORD (12+ characters).
DEMO_MODE=true
ADMIN_PASSWORD=

# Alerts for urgent emails, complaints, overdue replies and failures. Slack incoming webhook, https only.
# Without it, alerts go to the log.
ALERT_WEBHOOK_URL=
PUBLIC_URL=http://127.0.0.1:8030

# Google (milestone 3). Setup: see README "Connect Gmail and Google Sheets".
# The demo Gmail address. Setup and run commands refuse any other account.
INBOX_TEST_ACCOUNT=
# Which messages to process (Gmail search syntax). The demo uses label:Demo so only seeded fictional
# emails are read. A client's real setup would use: in:inbox -from:me newer_than:14d
INBOX_QUERY=label:Demo
# Written by: python -m inbox.google_setup create-sheet
SHEET_ID=

DATABASE_PATH=inbox.db
RULES_PATH=routing.yaml
